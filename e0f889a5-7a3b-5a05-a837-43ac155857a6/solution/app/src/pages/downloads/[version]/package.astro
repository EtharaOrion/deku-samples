---
import Shell from "../../../layouts/Shell.astro";
import NotFound from "../../../components/NotFound.astro";
import { call } from "../../../components/lib/api";
import { bytes, longDate } from "../../../components/lib/format";

const { version } = Astro.params;
const answer = await call<any>(Astro, `/api/releases/${encodeURIComponent(version ?? "")}`);
if (!answer.ok) Astro.response.status = answer.status === 404 ? 404 : answer.status;
const release = answer.ok ? answer.data : null;
---

{
  !release ? (
    <NotFound />
  ) : (
    <Shell title={`Arranger ${release.version} package`} current="downloads">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/downloads">Downloads</a> <span aria-hidden="true">/</span>{" "}
        <a href={`/downloads/${release.version}`}>Arranger {release.version}</a>{" "}
        <span aria-hidden="true">/</span> <span>Package</span>
      </nav>

      <header class="stack stack-3">
        <h1 class="page-title">Arranger {release.version}</h1>
        <p class="page-lede" data-package-status>
          The signed package <span class="mono">{release.artifact_name}</span> is not bundled
          in this environment, so there is nothing here to save. This is its record.
        </p>
      </header>

      <table class="table">
        <caption>What the package is</caption>
        <tbody>
          <tr>
            <th scope="row">Artifact</th>
            <td class="mono">{release.artifact_name}</td>
          </tr>
          <tr>
            <th scope="row">Build</th>
            <td class="mono">{release.build}</td>
          </tr>
          <tr>
            <th scope="row">Released on</th>
            <td>{longDate(release.released_on)}</td>
          </tr>
          <tr>
            <th scope="row">Size</th>
            <td class="tabular">{bytes(release.size_bytes)}</td>
          </tr>
          <tr>
            <th scope="row">SHA-256</th>
            <td class="mono digest">{release.sha256}</td>
          </tr>
        </tbody>
      </table>

      <p class="row" style="gap: calc(var(--spacing) * 3)">
        <a class="btn btn--secondary" href={`/downloads/${release.version}`}>
          Release notes for {release.version}
        </a>
        <a class="btn btn--quiet" href="/downloads">
          Back to downloads
        </a>
      </p>
    </Shell>
  )
}
