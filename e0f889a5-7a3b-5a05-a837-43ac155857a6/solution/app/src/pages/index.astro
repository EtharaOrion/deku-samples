---
import "../components/styles/letter.css";
import Base from "../layouts/Base.astro";
import FilmStage from "../components/FilmStage.astro";
import LetterFooter from "../components/LetterFooter.astro";
import Wordmark from "../components/Wordmark.astro";
import { LETTER, LETTER_DATE, LETTER_TITLE } from "../components/lib/letter";

export const prerender = false;

const titleCharacters = [...LETTER_TITLE];
---

<Base
  title="Vela Electronics"
  description="A letter from the table. Vela Electronics designs, builds and sells two cameras direct."
  ground="dark"
  skipTo="#writing"
  skipLabel="Skip to the writing"
  video={{ src: "/film/table.mp4", width: 1920, height: 1080 }}
>
  <div class="letter">
    <header class="letter__head">
      <Wordmark />
    </header>

    <FilmStage>
      <main class="writing" id="writing" tabindex="-1">
        <h1 class="writing__title" aria-label={LETTER_TITLE}>
          {titleCharacters.map((character, index) => <span class="char" style={`--i: ${index}`}>{character}</span>)}
        </h1>
        <p class="writing__dateline">
          <time datetime="2026-06-01">{LETTER_DATE}</time>
        </p>
        {
          LETTER.map((paragraph) => (
            <p
              class:list={[
                "writing__p",
                paragraph.half === "right" && "writing__p--right",
                paragraph.closing && "writing__p--closing",
              ]}
            >
              {paragraph.text}
            </p>
          ))
        }
      </main>
    </FilmStage>

    <LetterFooter />
  </div>
</Base>

<script>
  import "../components/islands/letter";
</script>
