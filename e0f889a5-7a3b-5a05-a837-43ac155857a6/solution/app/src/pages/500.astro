---
import Fault from "../layouts/Fault.astro";

const requestId = String(
  (Astro.locals as Record<string, unknown>).requestId ?? "unavailable",
);
---

<Fault title="Something went wrong">
  <div class="stack stack-4">
    <h1 class="page-title">Something went wrong at our end.</h1>
    <p class="page-lede">
      Try this page again. Reference <span class="mono">{requestId}</span>.
    </p>
    <p>
      <a class="btn btn--secondary" href="/">Go to the letter</a>
    </p>
  </div>
</Fault>
