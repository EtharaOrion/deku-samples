---
import "../components/styles/controls.css";
import "../components/styles/shell.css";
import Base from "./Base.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Base title={title} ground="dark">
  <div class="fault">
    <header class="fault__head">
      <Wordmark />
    </header>
    <main class="fault__body stack stack-6" id="content" tabindex="-1">
      <slot />
    </main>
  </div>
</Base>

<style>
  .fault {
    min-height: 100vh;
    min-height: 100svh;
    padding: var(--page-gutter);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .fault__head {
    height: var(--header-height);
    display: flex;
    align-items: center;
    border-bottom: var(--border-width) solid var(--color-rule-strong);
  }

  .fault__body {
    min-height: calc(100svh - var(--header-height) - var(--page-gutter) * 2);
    max-width: 48rem;
    justify-content: center;
  }
</style>
