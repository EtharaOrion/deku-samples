---
import Fault from "../layouts/Fault.astro";

const path = Astro.url.pathname;
const destination = path.startsWith("/shop/")
  ? { href: "/shop", label: "Go to the shop" }
  : path.startsWith("/downloads/")
    ? { href: "/downloads", label: "Go to downloads" }
    : { href: "/", label: "Go home" };
---

<Fault title="Not found">
  <div class="stack stack-4">
    <h1 class="page-title">That page does not exist.</h1>
    <p class="page-lede">
      The address you followed does not lead anywhere on this site.
    </p>
    <p>
      <a class="btn btn--secondary" href={destination.href}>{destination.label}</a>
    </p>
  </div>
</Fault>
