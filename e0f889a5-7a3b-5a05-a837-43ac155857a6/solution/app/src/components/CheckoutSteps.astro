---
interface Props {
  current: "where" | "how" | "pay";
}

const { current } = Astro.props;

// Each step is a real address, so the browser's own back control works.
const steps = [
  { key: "where", href: "/checkout/where-it-goes", label: "Where it goes" },
  { key: "how", href: "/checkout/how-it-gets-there", label: "How it gets there" },
  { key: "pay", href: "/checkout/payment", label: "Payment" },
];
const reached = steps.findIndex((step) => step.key === current);
---

<nav class="steps" aria-label="Checkout">
  {
    steps.map((step, index) => (
      <>
        {index > 0 && <span class="steps__sep" aria-hidden="true">/</span>}
        {index < reached ? (
          <a href={step.href}>{step.label}</a>
        ) : index === reached ? (
          <span class="steps__now" aria-current="step">
            {step.label}
          </span>
        ) : (
          <span>{step.label}</span>
        )}
      </>
    ))
  }
</nav>
