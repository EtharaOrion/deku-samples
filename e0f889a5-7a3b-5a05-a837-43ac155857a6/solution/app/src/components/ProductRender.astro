---
interface Props {
  handle: "flagship" | "compact" | "mount" | "case" | "cable";
  view?: "front" | "quarter" | "detail";
  label?: string;
  class?: string;
}

const { handle, view = "front", label, class: className } = Astro.props;

const uid = "pr" + Math.random().toString(36).slice(2, 8);
const ref = (name: string) => `url(#${uid}-${name})`;
const round = (value: number) => Math.round(value * 10) / 10;

const NAMES = {
  flagship: "Vela A1 camera",
  compact: "Vela Cricket camera",
  mount: "Monitor Mount",
  case: "Travel Case",
  cable: "Replacement Cable",
} as const;
const VIEW_NAMES = { front: "front view", quarter: "three-quarter view", detail: "detail view" } as const;
const name = label ?? `${NAMES[handle]}, ${VIEW_NAMES[view]}`;

const MATERIAL = "fill: var(--product-material, #3a3c40)";
const DARK = "#2b2b2e";
const SHELL = "#1f2022";
const BRAID = "#26272a";

const camera = handle === "flagship" || handle === "compact";
const quarter = view === "quarter";
const detail = view === "detail";

type Body = { x: number; y: number; w: number; h: number; rx: number };
const body: Body =
  handle === "flagship"
    ? quarter
      ? { x: 66, y: 68, w: 224, h: 154, rx: 30 }
      : { x: 80, y: 68, w: 240, h: 154, rx: 30 }
    : quarter
      ? { x: 110, y: 88, w: 152, h: 118, rx: 44 }
      : { x: 118, y: 88, w: 164, h: 118, rx: 44 };
const cx = body.x + body.w / 2;
const lensR = handle === "flagship" ? 52 : 40;
const lensY = handle === "flagship" ? 145 : 147;
const light = handle === "flagship" ? { cx: body.x + body.w - 28, cy: 92, r: 4.6 } : { cx: body.x + body.w - 24, cy: 106, r: 3.8 };
const footW = handle === "flagship" ? 104 : 88;
const sideDepth = 22;

// The coil is one closed loop with two tails that leave it exactly on the
// outline, so the cord reads as continuous rather than as parts laid together.
const coilCx = 200;
const coilCy = 128;
const coilRx = quarter ? 104 : 96;
const coilRy = quarter ? 44 : 62;
const diag = 0.7071;
const tailY = round(coilCy + coilRy * diag);
const tailLx = round(coilCx - coilRx * diag);
const tailRx = round(coilCx + coilRx * diag);
const tails = `M ${tailLx} ${tailY} C ${tailLx - 14} ${tailY + 18}, ${tailLx - 28} ${tailY + 36}, ${tailLx - 42} ${tailY + 52} M ${tailRx} ${tailY} C ${tailRx + 14} ${tailY + 18}, ${tailRx + 28} ${tailY + 36}, ${tailRx + 42} ${tailY + 52}`;
const plugLeft = `translate(${tailLx - 42} ${tailY + 52}) rotate(131)`;
const plugRight = `translate(${tailRx + 42} ${tailY + 52}) rotate(49)`;
---

<svg
  viewBox="0 0 400 300"
  role="img"
  aria-label={name}
  focusable="false"
  preserveAspectRatio="xMidYMid meet"
  class:list={["render", className]}
>
  <defs>
    <filter id={`${uid}-blur`} x="-30%" y="-150%" width="160%" height="400%">
      <feGaussianBlur stdDeviation="8"></feGaussianBlur>
    </filter>
    <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.3"></stop>
      <stop offset="0.42" stop-color="#ffffff" stop-opacity="0.04"></stop>
      <stop offset="1" stop-color="#000000" stop-opacity="0.26"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-metal`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#c9ccd0"></stop>
      <stop offset="0.45" stop-color="#8d9094"></stop>
      <stop offset="0.7" stop-color="#a9acb0"></stop>
      <stop offset="1" stop-color="#6d7075"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-ring`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d8dbdf"></stop>
      <stop offset="0.5" stop-color="#7d8085"></stop>
      <stop offset="1" stop-color="#3a3c40"></stop>
    </linearGradient>
    <radialGradient id={`${uid}-glass`} cx="0.38" cy="0.34" r="0.72">
      <stop offset="0" stop-color="#6f8fc4"></stop>
      <stop offset="0.3" stop-color="#2c3853"></stop>
      <stop offset="0.72" stop-color="#0c0e15"></stop>
      <stop offset="1" stop-color="#04050a"></stop>
    </radialGradient>
    <pattern id={`${uid}-ridge`} width="7" height="7" patternUnits="userSpaceOnUse">
      <rect width="7" height="1.4" fill="#ffffff" fill-opacity="0.045"></rect>
      <rect y="3.5" width="7" height="0.8" fill="#000000" fill-opacity="0.18"></rect>
    </pattern>
    <pattern id={`${uid}-weave`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="7" height="7" fill={BRAID}></rect>
      <rect width="7" height="3" fill="#ffffff" fill-opacity="0.09"></rect>
      <rect y="5" width="7" height="1" fill="#000000" fill-opacity="0.35"></rect>
    </pattern>
  </defs>

  {
    camera && !detail && (
      <>
        <ellipse
          cx={cx + (quarter ? 10 : 0)}
          cy={body.y + body.h + 28}
          rx={body.w * 0.5}
          ry="13"
          fill="#000000"
          opacity="0.25"
          filter={ref("blur")}
        />
        <g transform={quarter ? "translate(0 10) skewY(-3)" : undefined}>
          {quarter && (
            <rect x={body.x + sideDepth} y={body.y + 6} width={body.w} height={body.h - 8} rx={body.rx} style={MATERIAL} />
          )}
          {quarter && (
            <rect
              x={body.x + sideDepth}
              y={body.y + 6}
              width={body.w}
              height={body.h - 8}
              rx={body.rx}
              fill="#000000"
              fill-opacity="0.4"
            />
          )}
          <rect x={body.x} y={body.y} width={body.w} height={body.h} rx={body.rx} style={MATERIAL} />
          <rect x={body.x} y={body.y} width={body.w} height={body.h} rx={body.rx} fill={ref("sheen")} />
          <rect
            x={body.x + 0.5}
            y={body.y + 0.5}
            width={body.w - 1}
            height={body.h - 1}
            rx={body.rx}
            fill="none"
            stroke="#000000"
            stroke-opacity="0.28"
          />
          <rect
            x={body.x + 3}
            y={body.y + 3}
            width={body.w - 6}
            height={body.h - 6}
            rx={body.rx - 3}
            fill="none"
            stroke="#ffffff"
            stroke-opacity="0.12"
          />
          {handle === "flagship" && (
            <>
              <line x1={body.x + 18} y1={body.y + 34} x2={body.x + body.w - 18} y2={body.y + 34} stroke="#000000" stroke-opacity="0.35" />
              <line x1={body.x + 18} y1={body.y + 35.5} x2={body.x + body.w - 18} y2={body.y + 35.5} stroke="#ffffff" stroke-opacity="0.12" />
            </>
          )}
          <g transform={`translate(${cx} ${lensY}) scale(${(lensR / 50).toFixed(3)})`}>
            <circle r="50" fill={ref("ring")} />
            <circle r="43" fill="#17181b" />
            <circle r="38" fill={ref("glass")} />
            <ellipse cx="-8" cy="-6" rx="20" ry="12" fill="#8b74e0" fill-opacity="0.16" />
            <ellipse cx="7" cy="9" rx="14" ry="8" fill="#3ea0c8" fill-opacity="0.12" />
            <circle r="22" fill="#0c0e13" stroke="#2f3542" stroke-width="1.5" />
            <circle r="16" fill={ref("glass")} />
            <circle cx="-14" cy="-14" r="3.2" fill="#ffffff" fill-opacity="0.9" />
            <circle cx="-20" cy="-8" r="1.5" fill="#ffffff" fill-opacity="0.5" />
          </g>
          <circle cx={light.cx} cy={light.cy} r={light.r * 1.8} fill="#dfe3e8" fill-opacity="0.2" />
          <circle cx={light.cx} cy={light.cy} r={light.r} fill="#dfe3e8" />
          <rect x={cx - 9} y={body.y + body.h - 2} width="18" height="12" fill={BRAID} />
          <rect x={cx - footW / 2} y={body.y + body.h + 8} width={footW} height="12" rx="6" fill={ref("metal")} />
          <rect
            x={cx - footW / 2 + 0.5}
            y={body.y + body.h + 8.5}
            width={footW - 1}
            height="11"
            rx="6"
            fill="none"
            stroke="#000000"
            stroke-opacity="0.22"
          />
        </g>
      </>
    )
  }

  {
    camera && detail && (
      <>
        <rect width="400" height="300" style={MATERIAL} />
        <rect width="400" height="300" fill={ref("sheen")} />
        {handle === "flagship" && (
          <>
            <line x1="0" y1="30" x2="400" y2="30" stroke="#000000" stroke-opacity="0.35" stroke-width="2" />
            <line x1="0" y1="33" x2="400" y2="33" stroke="#ffffff" stroke-opacity="0.12" stroke-width="2" />
            <circle cx="356" cy="52" r="14" fill="#dfe3e8" fill-opacity="0.2" />
            <circle cx="356" cy="52" r="8" fill="#dfe3e8" />
          </>
        )}
        <ellipse cx="200" cy="270" rx="150" ry="16" fill="#000000" opacity="0.28" filter={ref("blur")} />
        <g transform={`translate(200 ${handle === "flagship" ? 160 : 150}) scale(2.3)`}>
          <circle r="50" fill={ref("ring")} />
          <circle r="43" fill="#17181b" />
          <circle r="43" fill="none" stroke="#ffffff" stroke-opacity="0.18" stroke-width="0.6" stroke-dasharray="1.2 2.4" />
          <circle r="38" fill={ref("glass")} />
          <ellipse cx="-8" cy="-6" rx="20" ry="12" fill="#8b74e0" fill-opacity="0.18" />
          <ellipse cx="7" cy="9" rx="14" ry="8" fill="#3ea0c8" fill-opacity="0.14" />
          <circle r="22" fill="#0c0e13" stroke="#2f3542" stroke-width="1.5" />
          <circle r="16" fill={ref("glass")} />
          <circle r="7" fill="#04050a" />
          <circle cx="-14" cy="-14" r="3.2" fill="#ffffff" fill-opacity="0.9" />
          <circle cx="-20" cy="-8" r="1.5" fill="#ffffff" fill-opacity="0.5" />
        </g>
      </>
    )
  }

  {
    handle === "mount" && !detail && (
      <>
        <ellipse cx="208" cy="268" rx="74" ry="10" fill="#000000" opacity="0.25" filter={ref("blur")} />
        {quarter && (
          <>
            <path d="M 148 96 L 162 88 L 286 88 L 272 96 Z" fill="#3f4045" />
            <path d="M 272 96 L 286 88 L 286 214 L 272 222 Z" fill="#141517" />
            <path d="M 170 190 L 184 182 L 272 182 L 272 190 Z" fill="#3f4045" />
            <path d="M 186 30 L 198 23 L 246 23 L 234 30 Z" fill="#3f4045" />
            <path d="M 202 62 L 214 55 L 214 96 L 202 103 Z" fill="#141517" />
          </>
        )}
        <rect x="186" y="30" width="48" height="15" rx="4" fill={DARK} />
        <rect x="186" y="30" width="48" height="15" rx="4" fill={ref("sheen")} />
        <rect x="192" y="34" width="36" height="5" rx="2.5" fill={ref("metal")} />
        <circle cx="210" cy="56" r="14" fill={ref("metal")} />
        <circle cx="210" cy="56" r="14" fill="none" stroke="#000000" stroke-opacity="0.35" />
        <ellipse cx="205" cy="50" rx="6" ry="3.5" fill="#ffffff" fill-opacity="0.4" />
        <rect x="202" y="62" width="16" height="36" fill={DARK} />
        <rect x="202" y="62" width="16" height="36" fill={ref("sheen")} />
        <rect x="250" y="96" width="22" height="122" rx="6" fill={DARK} />
        <rect x="250" y="96" width="22" height="122" rx="6" fill={ref("sheen")} />
        <rect x="148" y="96" width="124" height="24" rx="7" fill={DARK} />
        <rect x="148" y="96" width="124" height="24" rx="7" fill={ref("sheen")} />
        <rect x="170" y="190" width="102" height="24" rx="7" fill={DARK} />
        <rect x="170" y="190" width="102" height="24" rx="7" fill={ref("sheen")} />
        <rect x="156" y="120" width="44" height="7" rx="3" fill={ref("metal")} />
        <rect x="178" y="183" width="44" height="7" rx="3" fill={ref("metal")} />
        <rect x="203" y="214" width="12" height="20" fill={ref("metal")} />
        <circle cx="209" cy="244" r="17" fill={ref("metal")} />
        <circle cx="209" cy="244" r="17" fill="none" stroke="#000000" stroke-opacity="0.35" />
        <circle
          cx="209"
          cy="244"
          r="14"
          fill="none"
          stroke="#000000"
          stroke-opacity="0.3"
          stroke-dasharray="1.8 3"
        />
      </>
    )
  }

  {
    handle === "mount" && detail && (
      <>
        <ellipse cx="196" cy="292" rx="130" ry="9" fill="#000000" opacity="0.25" filter={ref("blur")} />
        <rect x="266" y="16" width="76" height="264" rx="14" fill={DARK} />
        <rect x="266" y="16" width="76" height="264" rx="14" fill={ref("sheen")} />
        <rect x="30" y="16" width="312" height="68" rx="14" fill={DARK} />
        <rect x="30" y="16" width="312" height="68" rx="14" fill={ref("sheen")} />
        <rect x="42" y="23" width="288" height="10" rx="5" fill="#ffffff" fill-opacity="0.12" />
        <rect x="30" y="212" width="312" height="68" rx="14" fill={DARK} />
        <rect x="30" y="212" width="312" height="68" rx="14" fill={ref("sheen")} />
        <rect x="42" y="219" width="288" height="8" rx="4" fill="#ffffff" fill-opacity="0.08" />
        <rect x="64" y="84" width="152" height="22" rx="6" fill={ref("metal")} />
        <rect
          x="64.5"
          y="84.5"
          width="151"
          height="21"
          rx="6"
          fill="none"
          stroke="#000000"
          stroke-opacity="0.35"
        />
        <rect x="72" y="88" width="136" height="6" rx="3" fill="#ffffff" fill-opacity="0.32" />
        <rect x="126" y="158" width="34" height="54" fill="#3b3b3f" />
        <path
          d="M 126 168 H 160 M 126 180 H 160 M 126 192 H 160 M 126 204 H 160"
          stroke="#000000"
          stroke-opacity="0.35"
          stroke-width="2"
        />
        <rect x="90" y="134" width="106" height="26" rx="7" fill={ref("metal")} />
        <rect
          x="90.5"
          y="134.5"
          width="105"
          height="25"
          rx="7"
          fill="none"
          stroke="#000000"
          stroke-opacity="0.35"
        />
        <rect x="98" y="138" width="90" height="7" rx="3.5" fill="#ffffff" fill-opacity="0.32" />
      </>
    )
  }

  {
    handle === "case" && !detail && (
      <>
        <ellipse cx="200" cy="246" rx="140" ry="14" fill="#000000" opacity="0.25" filter={ref("blur")} />
        {quarter && (
          <>
            <path d="M 92 92 L 112 82 L 350 82 L 308 92 Z" fill="#2a2b2e" />
            <path d="M 308 92 L 350 82 L 350 214 L 308 230 Z" fill="#141517" />
          </>
        )}
        <rect x="70" y="92" width="260" height="138" rx="22" fill={SHELL} />
        <rect x="70" y="92" width="260" height="138" rx="22" fill={ref("ridge")} />
        <rect x="70" y="92" width="260" height="138" rx="22" fill={ref("sheen")} />
        <rect x="70.5" y="92.5" width="259" height="137" rx="22" fill="none" stroke="#000000" stroke-opacity="0.35" />
        <line x1="76" y1="162" x2="324" y2="162" stroke="#000000" stroke-opacity="0.55" stroke-width="2" />
        <line x1="76" y1="164" x2="324" y2="164" stroke="#ffffff" stroke-opacity="0.09" />
        <rect x="158" y="66" width="84" height="30" rx="14" fill={SHELL} />
        <rect x="158" y="66" width="84" height="30" rx="14" fill={ref("sheen")} />
        <rect x="170" y="74" width="60" height="12" rx="6" fill="#0b0c0e" />
        <rect x="114" y="146" width="44" height="32" rx="5" fill={ref("metal")} />
        <rect x="114.5" y="146.5" width="43" height="31" rx="5" fill="none" stroke="#000000" stroke-opacity="0.35" />
        <rect x="120" y="150" width="32" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.35" />
        <rect x="122" y="160" width="28" height="10" rx="2" fill="#000000" fill-opacity="0.3" />
        <rect x="242" y="146" width="44" height="32" rx="5" fill={ref("metal")} />
        <rect x="242.5" y="146.5" width="43" height="31" rx="5" fill="none" stroke="#000000" stroke-opacity="0.35" />
        <rect x="248" y="150" width="32" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.35" />
        <rect x="250" y="160" width="28" height="10" rx="2" fill="#000000" fill-opacity="0.3" />
        <rect x="102" y="228" width="34" height="8" rx="3" fill="#0b0c0e" />
        <rect x="264" y="228" width="34" height="8" rx="3" fill="#0b0c0e" />
      </>
    )
  }

  {
    handle === "case" && detail && (
      <>
        <rect width="400" height="300" fill={SHELL} />
        <rect width="400" height="300" fill={ref("ridge")} />
        <rect width="400" height="300" fill={ref("sheen")} />
        <line x1="0" y1="150" x2="400" y2="150" stroke="#000000" stroke-opacity="0.6" stroke-width="4" />
        <line x1="0" y1="153" x2="400" y2="153" stroke="#ffffff" stroke-opacity="0.09" stroke-width="2" />
        <ellipse cx="200" cy="200" rx="90" ry="10" fill="#000000" opacity="0.3" filter={ref("blur")} />
        <rect x="120" y="110" width="160" height="80" rx="14" fill={ref("metal")} />
        <rect x="120.5" y="110.5" width="159" height="79" rx="14" fill="none" stroke="#000000" stroke-opacity="0.3" />
        <rect x="170" y="150" width="60" height="30" rx="6" fill="#8d9094" />
        <rect x="132" y="122" width="136" height="28" rx="8" fill="#c9ccd0" />
        <rect x="132" y="146" width="136" height="4" rx="2" fill="#000000" fill-opacity="0.25" />
        <circle cx="140" cy="176" r="5" fill="#6d7075" />
        <circle cx="260" cy="176" r="5" fill="#6d7075" />
      </>
    )
  }

  {
    handle === "cable" && !detail && (
      <>
        <ellipse cx="200" cy="246" rx="126" ry="11" fill="#000000" opacity="0.25" filter={ref("blur")} />
        <path d={tails} stroke={BRAID} stroke-width="15" stroke-linecap="round" fill="none" />
        <path d={tails} stroke={ref("weave")} stroke-width="13" stroke-linecap="round" fill="none" />
        <ellipse cx={coilCx} cy={coilCy} rx={coilRx} ry={coilRy} stroke={BRAID} stroke-width="17" fill="none" />
        <ellipse cx={coilCx} cy={coilCy} rx={coilRx} ry={coilRy} stroke={ref("weave")} stroke-width="15" fill="none" />
        <ellipse
          cx={coilCx}
          cy={coilCy - 2}
          rx={coilRx}
          ry={coilRy}
          stroke="#ffffff"
          stroke-opacity="0.1"
          stroke-width="4"
          fill="none"
        />
        <g transform={plugLeft}>
          <rect x="-8" y="-8" width="18" height="16" rx="5" fill="#1a1b1d" />
          <rect x="4" y="-10" width="34" height="20" rx="6" fill={ref("metal")} />
          <rect x="4.5" y="-9.5" width="33" height="19" rx="6" fill="none" stroke="#000000" stroke-opacity="0.3" />
          <rect x="8" y="-8" width="27" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.3" />
          <rect x="34" y="-7" width="20" height="14" rx="7" fill="#cfd2d6" />
          <rect x="40" y="-3.5" width="11" height="7" rx="3.5" fill="#101216" />
        </g>
        <g transform={plugRight}>
          <rect x="-8" y="-8" width="18" height="16" rx="5" fill="#1a1b1d" />
          <rect x="4" y="-10" width="34" height="20" rx="6" fill={ref("metal")} />
          <rect x="4.5" y="-9.5" width="33" height="19" rx="6" fill="none" stroke="#000000" stroke-opacity="0.3" />
          <rect x="8" y="-8" width="27" height="5" rx="2.5" fill="#ffffff" fill-opacity="0.3" />
          <rect x="34" y="-7" width="20" height="14" rx="7" fill="#cfd2d6" />
          <rect x="40" y="-3.5" width="11" height="7" rx="3.5" fill="#101216" />
        </g>
      </>
    )
  }

  {
    handle === "cable" && detail && (
      <>
        <ellipse cx="220" cy="214" rx="150" ry="14" fill="#000000" opacity="0.25" filter={ref("blur")} />
        <path d="M -10 150 C 40 150, 60 150, 96 150" stroke={BRAID} stroke-width="34" stroke-linecap="round" fill="none" />
        <path d="M -10 150 C 40 150, 60 150, 96 150" stroke={ref("weave")} stroke-width="34" stroke-linecap="round" fill="none" />
        <path d="M -10 143 C 40 143, 60 143, 96 143" stroke="#ffffff" stroke-opacity="0.1" stroke-width="8" stroke-linecap="round" fill="none" />
        <rect x="88" y="120" width="44" height="60" rx="14" fill="#1a1b1d" />
        <rect x="88" y="120" width="44" height="60" rx="14" fill={ref("sheen")} />
        <rect x="124" y="112" width="176" height="76" rx="22" fill={ref("metal")} />
        <rect x="124.5" y="112.5" width="175" height="75" rx="22" fill="none" stroke="#000000" stroke-opacity="0.3" />
        <rect x="292" y="128" width="60" height="44" rx="14" fill="#cfd2d6" stroke="#7d8084" stroke-width="1.5" />
        <rect x="304" y="140" width="40" height="20" rx="8" fill="#3a3c40" />
        <rect x="140" y="124" width="140" height="6" rx="3" fill="#ffffff" fill-opacity="0.3" />
      </>
    )
  }
</svg>

<style>
  .render {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
