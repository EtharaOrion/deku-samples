---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "Vela Electronics, home" } = Astro.props;
---

<a class="wordmark" href={href} aria-label={label}>
  <span class="wordmark__line" aria-hidden="true">vela</span>
  <span class="wordmark__line" aria-hidden="true">electronics</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    height: calc(var(--header-height) / 2);
    font-weight: 700;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: var(--tracking-tighter);
    text-transform: lowercase;
    text-decoration: none;
    color: inherit;
  }

  .wordmark__line {
    display: block;
    white-space: nowrap;
  }
</style>
