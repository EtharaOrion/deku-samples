---
import Wordmark from "./Wordmark.astro";
import { FOOTER_ENTRIES } from "./lib/letter";
---

<footer class="letter-footer" id="letter-footer">
  {/* A drawing that carries no information: a field of dots with the company
      name drawn by the gaps between them. It is named so a reader who lands
      on it knows what it is, and it is not keyboard operable. */}
  <canvas
    class="matrix"
    id="matrix"
    role="img"
    aria-label="A field of dots. The company name is the gaps between them."
    hidden></canvas>

  <div class="footer-row">
    <Wordmark href="/" label="Vela Electronics, home" />
    <span class="footer-row__rights">All rights reserved</span>
    <nav class="footer-row__links" aria-label="Company">
      {
        FOOTER_ENTRIES.map((entry) =>
          entry.href ? <a href={entry.href}>{entry.label}</a> : <span>{entry.label}</span>,
        )
      }
    </nav>
  </div>
</footer>
