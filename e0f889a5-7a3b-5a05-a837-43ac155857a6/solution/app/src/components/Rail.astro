---
interface Props {
  current?: string | undefined;
  signedIn: boolean;
  idPrefix?: string;
}

const { current, signedIn, idPrefix = "rail" } = Astro.props;

const shopping = [
  { key: "shop", href: "/shop", label: "Shop" },
  { key: "downloads", href: "/downloads", label: "Downloads" },
  { key: "doctor", href: "/doctor", label: "Firmware installer" },
];

const account = [
  { key: "account", href: "/account", label: "Overview" },
  { key: "orders", href: "/account/orders", label: "Orders" },
  { key: "cameras", href: "/account/cameras", label: "Cameras" },
];
---

<nav class="rail" aria-label="Sections">
  <ul class="rail__group">
    {
      shopping.map((entry) => (
        <li>
          <a
            class="rail__link"
            href={entry.href}
            aria-current={current === entry.key ? "page" : undefined}
          >
            {entry.label}
          </a>
        </li>
      ))
    }
  </ul>
  {
    signedIn && (
      <ul class="rail__group" aria-labelledby={`${idPrefix}-account`}>
        <li class="rail__heading" id={`${idPrefix}-account`} role="presentation">
          Your account
        </li>
        {account.map((entry) => (
          <li>
            <a
              class="rail__link"
              href={entry.href}
              aria-current={current === entry.key ? "page" : undefined}
            >
              {entry.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</nav>
